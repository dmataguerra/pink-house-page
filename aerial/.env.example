FLYOVER_MODE=illustrated
# Set FLYOVER_MODE=surveyed only when supplying an independent surveyed 3D dataset.
# Never commit credentials or license documents. No Google imagery is recorded.
# Use a separately licensed, surveyed, georeferenced textured 3D Tiles dataset.
DATASET_MANIFEST=./private/dataset.json
# Optional overrides; npm packages provide Windows binaries by default.
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe
# Optionally use an installed Chromium-family browser instead of downloading one.
# CHROMIUM_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# SOFTWARE_RENDERING=true
